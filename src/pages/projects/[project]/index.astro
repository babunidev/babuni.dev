---
import ReadingPage from '../../../layouts/ReadingPage.astro';
import {publicProjects} from '../../../lib/server/public-projects';
import {markdownHtml} from '../../../lib/server/markdown-html';
import {SITE_URL,projectPath,modulePath} from '../../../lib/site';
// Kept byte-for-byte as supplied by the game; served from src so the public/ WebP guard does not apply.
import buttonGameQr from '../../../assets/buttongame-qr.svg?url';
export function getStaticPaths(){return publicProjects.map(project=>({params:{project:project.id},props:{project}}));}
const {project}=Astro.props;
const overview=project.modules.find(m=>m.id==='overview'&&m.type==='text');
// A curated `play` resources module becomes the page's labelled call to play.
const play=project.modules.find(m=>m.id==='play'&&m.type==='resources')?.links?.[0];
// The live game is served by its own server at this address; the website only links to it.
const BUTTON_GAME_URL='https://babuni.dev/Buttongame/';
const structured={'@context':'https://schema.org','@type':'CreativeWork',name:project.name,description:project.shortSummary,url:SITE_URL+projectPath(project.id),author:{'@type':'Person',name:'Babuni',url:SITE_URL+'/'},image:SITE_URL+project.portalArtwork};
---
<ReadingPage title={`${project.name} — Babuni.dev`} description={project.shortSummary} image={project.portalArtwork} structured={structured}><img class="project-art" src={project.portalArtwork} width="112" height="112" alt={`${project.name} artwork`} /><h1>{project.name}</h1><p>{project.shortSummary}</p>{project.id==='button-game'&&<div class="bg-play"><a class="bg-play__link" href={BUTTON_GAME_URL}>Play Button Game</a><a href={BUTTON_GAME_URL} aria-label="Play Button Game"><img class="bg-play__qr" src={buttonGameQr} width="180" height="180" alt="QR code to play Button Game at babuni.dev/Buttongame" /></a><p class="bg-play__hint">Scan with your phone to join the live game and the top-100 high score list.</p></div>}{play&&<p><a class="play-link" href={play.href}>{play.label}</a></p>}{overview&&<article set:html={markdownHtml(overview.intro??overview.preview,overview.source)} />}<h2>Explore this project</h2><ul class="module-list">{project.modules.map(module=><li><h2><a href={modulePath(project.id,module.id)}>{module.title}</a></h2><p>{module.preview.replace(/[*#`]/g,'')}</p></li>)}</ul></ReadingPage>
<style>
  .bg-play{clear:both;box-sizing:border-box;max-width:300px;margin:24px auto;padding:22px 20px 20px;border-radius:16px;background:#071518;color:#c8e8e8;text-align:center;font-family:system-ui,-apple-system,"Segoe UI",sans-serif}
  .bg-play *{box-sizing:border-box}
  .bg-play__link{display:inline-block;padding:12px 22px;border-radius:999px;background:#2ec4c4;color:#041013;font-weight:700;font-size:1.1rem;line-height:1.3;text-decoration:none}
  .bg-play__link:hover,.bg-play__link:focus-visible{background:#5fe0e0}
  .bg-play__link:focus-visible{outline:3px solid #fff;outline-offset:3px}
  .bg-play__qr{display:block;width:180px;height:180px;max-width:none;margin:18px auto 10px;padding:8px;border-radius:10px;background:#fff}
  .bg-play__hint{margin:0;font-size:.85rem;line-height:1.4;opacity:.85}
</style>
