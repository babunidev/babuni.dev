---
const title='babuni.dev — Living Grid Prototype';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#141518" />
  <meta name="description" content="An interactive portfolio toy-box prototype: explore a freely draggable wall of creative project tiles." />
  <link rel="icon" type="image/webp" sizes="64x64" href="/favicon.webp?v=b-mark-1" />
  <title>{title}</title>
</head>
<body>
  <main class="experience" aria-label="Living grid prototype">
    <div id="grid-viewport" class="grid-viewport" tabindex="0" aria-label="Endless project grid. Drag with a mouse or finger to move. Tab highlights the center tile. Arrow keys choose a tile or module; Space opens it; Escape returns one stage.">
      <div id="grid-world" class="grid-world"></div>
    </div>
    <header class="site-header">
      <div class="brand"><img src="/favicon.webp?v=b-mark-1" width="32" height="32" alt="" aria-hidden="true" />BABUNI.DEV</div>
      <nav class="site-nav" aria-label="Main navigation">
        <button id="projects-toggle" type="button" aria-expanded="false" aria-controls="projects-menu">Projects</button>
        <button id="about-toggle" type="button">About</button>
        <div class="site-help">
          <button id="help-toggle" type="button" aria-label="How to use the site" aria-expanded="false" aria-controls="site-help-content">?</button>
          <div id="site-help-content" role="region" aria-label="Site controls">
            <p>Drag or swipe to explore. Tab highlights the center tile. Arrow keys choose a tile or module; Space or Enter opens it. Escape returns one stage. Choose a project to open its small bloom, then a module for its big bloom. Read more opens the reader.</p>
            <p>The project tile returns one step. Tap or click outside the reader, or press Escape, to close it. Projects lets you find a project directly.</p>
            <button id="reset-view" type="button">Return to center</button>
          </div>
        </div>
        <div id="projects-menu" hidden>
          <label for="project-search">Find a project</label>
          <input id="project-search" type="search" placeholder="Search projects…" autocomplete="off" />
          <p id="project-result-count" role="status" aria-live="polite"></p>
          <div id="project-results"></div>
        </div>
      </nav>
      <span class="header-note">Living grid prototype</span>
    </header>
    <div id="grid-status" class="sr-only" role="status" aria-live="polite"></div>
  </main>
  <script>
    import '../scripts/grid';
  </script>
</body>
</html>
<style is:global>
  /* Hide scrollbar chrome without disabling native reading gestures. */
  *{scrollbar-width:none}
  *::-webkit-scrollbar{display:none;width:0;height:0}
  :root {font-family:Georgia,'Times New Roman',serif;color-scheme:dark;font-synthesis:none}
  *{box-sizing:border-box}
  html,body{width:100%;height:100%;margin:0;background:#17181a;overflow:hidden}
  button{font:inherit}
  .experience,.grid-viewport{position:fixed;inset:0;width:100%;height:100%}
  .grid-viewport{overflow:hidden;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;outline-offset:-4px}
  .grid-viewport.is-dragging{cursor:grabbing}
  .grid-viewport:focus-visible{outline:3px solid #beabd8}
  .grid-world{position:absolute;top:0;left:0;will-change:transform;pointer-events:none}
  .grid-tile{position:absolute;width:var(--tile-size,240px);height:var(--tile-size,240px);padding:2px;background:#111215}
  /* Bloom temporarily displaces the entire right-hand run, freeing a real cell. */
  .grid-viewport.is-bloom-opening .grid-tile--bloom-shifted,
  .grid-viewport.is-bloom-closing .grid-tile--bloom-returning{transition:transform 520ms cubic-bezier(.22,.75,.25,1)}
  .grid-tile--selected .tile-face{border-color:#d8bd91;box-shadow:inset 0 0 0 4px #393837,inset 0 0 0 5px #b39973,0 0 15px rgba(224,190,138,.48)}
  .tile-select{position:absolute;inset:0;z-index:4;appearance:none;border:0;background:transparent;cursor:pointer;pointer-events:auto}
  .grid-tile.keyboard-highlight .tile-face,.grid-bloom-module.keyboard-highlight{outline:3px solid #e3c99b;outline-offset:-7px}
  .tile-select:focus-visible{outline:3px solid #e3c99b;outline-offset:-10px}
  /* Acknowledgement only: opacity changes, never the tile's shift transform. */
  .grid-tile--waiting .tile-select::after{content:'';position:absolute;inset:4px;border:3px solid #ffe0a3;box-shadow:inset 0 0 24px rgba(255,210,130,.48),0 0 24px rgba(255,210,130,.7);pointer-events:none;animation:selection-wait 1400ms ease-in-out infinite}
  @keyframes selection-wait{0%,100%{opacity:.45}50%{opacity:1}}
  .tile-portal{position:relative;z-index:2}
  .tile-name{position:relative;pointer-events:none}
  .grid-bloom-module{position:absolute;z-index:2;width:var(--tile-size);height:var(--tile-size);padding:clamp(12px,calc(var(--tile-size) * .085),23px);display:flex;flex-direction:column;gap:10px;justify-content:center;border:2px solid #9b876e;background:radial-gradient(circle at 32% 20%,#32313b,#191a21 85%);box-shadow:inset 0 0 0 5px #37333a,0 0 22px rgba(0,0,0,.45);color:#e9dfd2;opacity:0;transform:scale(.92);transition:opacity 270ms ease,transform 330ms ease;overflow:auto;pointer-events:none}
  .grid-bloom-module.is-open{opacity:1;transform:scale(1);pointer-events:auto}
  .bloom-kicker{font:600 9px/1.3 system-ui,sans-serif;letter-spacing:.18em;color:#b3a5ba}
  .bloom-title{font:600 clamp(13px,calc(var(--tile-size) * .074),18px)/1.12 Georgia,serif;margin:0;overflow-wrap:anywhere}
  .bloom-summary{font:400 clamp(11px,calc(var(--tile-size) * .053),14px)/1.35 system-ui,sans-serif;margin:0;color:#c8c2cb;overflow:auto}
  .bloom-close{align-self:flex-start;border:1px solid #a7977e;border-radius:5px;background:#282730;color:#e6dccc;padding:5px 10px;cursor:pointer;pointer-events:auto}
  .bloom-close:focus-visible{outline:2px solid #e3c99b;outline-offset:3px}
  .grid-bloom-module{justify-content:flex-start;gap:8px;scrollbar-width:none}
  .bloom-media{display:block;width:100%;min-height:60px;max-height:58%;aspect-ratio:16/9;object-fit:contain;margin:0;background:#101116;border:0;flex-shrink:0}
  .bloom-media img{width:100%;height:100%;object-fit:contain}
  .bloom-action{font:500 11px/1.3 system-ui,sans-serif;color:#e8d3b0;cursor:pointer;display:block;pointer-events:auto;background:#282730;border:1px solid #726858;padding:4px 6px;text-decoration:none}
  .bloom-action:focus-visible{outline:2px solid #e3c99b;outline-offset:2px}
  .grid-bloom-module .bloom-summary{flex-shrink:0}
  @media(max-width:520px){.grid-bloom-module{padding:9px;gap:6px}.bloom-kicker{font-size:8px}.bloom-title{font-size:12px}.bloom-summary{font-size:10px}.bloom-close{font-size:10px;padding:3px 7px}}

  .tile-face{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7%;position:relative;border:1px solid #686461;background:radial-gradient(ellipse at 42% 40%,#55514e 0%,#423f3e 50%,#292929 100%);box-shadow:inset 0 0 0 4px #393837,inset 0 0 0 5px #6a6258}
  /* The child face grows into place; the parent remains free for line movement. */
  .grid-tile--spawning .tile-face{animation:tile-spawn 373ms cubic-bezier(.18,.78,.22,1) var(--tile-spawn-delay,0ms) both;transform-origin:center}
  @keyframes tile-spawn{
    0%{opacity:0;transform:scale(.28)}
    73%{opacity:1;transform:scale(1.065)}
    100%{opacity:1;transform:scale(1)}
  }
  .grid-tile--placeholder .tile-portal-cluster,.grid-tile--placeholder .tile-name,.grid-tile--placeholder .tile-select{display:none}
  .grid-tile--placeholder .tile-face{background:radial-gradient(ellipse at 42% 40%,#49494a,#363638 65%,#2d2d2f);border-color:#646466}
  .grid-tile--placeholder .tile-face::after{content:"";position:absolute;left:50%;top:50%;width:24px;height:24px;transform:translate(-50%,-50%) rotate(45deg);border:1px solid #81818466;box-shadow:inset 2px 2px 3px #1117,1px 1px 1px #aaa2;pointer-events:none}
  .grid-tile--placeholder[data-neutral-variant="1"] .tile-face::after{border-radius:50%;transform:translate(-50%,-50%);}
  .grid-tile--placeholder[data-neutral-variant="2"] .tile-face::after{transform:translate(-50%,-50%);width:18px;height:18px;}
  .tile-face::before{content:'';position:absolute;inset:9px;border:1px solid #777068;opacity:.43;pointer-events:none}
  /* One shared portal circle; its three diamond markers use the same radius.
     Anchoring to the portal rather than the label keeps every tile symmetric. */
  .tile-portal-cluster{
    --marker-edge-gap:calc(var(--tile-size,240px) * .06);
    --marker-size:7px;
    position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);
    width:56%;aspect-ratio:1;z-index:2;pointer-events:none
  }
  .tile-mark{
    position:absolute;width:var(--marker-size);height:var(--marker-size);
    z-index:2;border:1px solid #b6a487;transform:rotate(45deg);
    transition:background-color 180ms,box-shadow 180ms,border-color 180ms
  }
  .tile-mark--top{left:calc(50% - 3.5px);top:calc(0px - var(--marker-edge-gap) - 7px)}
  .tile-mark--left{left:calc(0px - var(--marker-edge-gap) - 7px);top:calc(50% - 3.5px)}
  .tile-mark--right{left:calc(100% + var(--marker-edge-gap));top:calc(50% - 3.5px)}
  .grid-tile--topic-open[data-topic-mode~="top"] .tile-mark--top,
  .grid-tile--topic-open[data-topic-mode~="left"] .tile-mark--left,
  .grid-tile--topic-open[data-topic-mode~="right"] .tile-mark--right{
    border-color:#f5ecda;background:var(--portal-color);
    box-shadow:0 0 0 2px #1b1b21,0 0 9px 3px var(--portal-color),0 0 17px var(--portal-color)
  }
  /* Topic wings may cross neighboring tiles; lift the source stacking context
     so later tiles and bloom modules cannot paint over their text. */
  .grid-tile--topic-open{z-index:3}
  .tile-topic{position:absolute;top:auto;bottom:calc(100% + var(--marker-edge-gap) + 7px);left:50%;right:auto;z-index:3;pointer-events:none;width:max-content;max-width:min(230px,70vw);padding:6px 9px;border-radius:3px;border:1px solid #837c91;background:rgba(19,20,28,.96);box-shadow:0 4px 16px rgba(0,0,0,.44);font:500 clamp(10px,calc(var(--tile-size,240px) * .047),12px)/1.25 system-ui,sans-serif;letter-spacing:.015em;color:#f0e8d9;overflow-wrap:anywhere;opacity:0;--topic-offset-x:-50%;transform:translate(var(--topic-offset-x),5px) scale(.95);transform-origin:bottom center;transition:opacity 150ms ease,transform 180ms ease}
  .tile-topic--left{bottom:calc(50% + 3.5px);left:auto;right:calc(100% + var(--marker-edge-gap) + 7px);--topic-offset-x:0%;transform-origin:bottom right}
  .tile-topic--right{bottom:calc(50% + 3.5px);left:calc(100% + var(--marker-edge-gap));--topic-offset-x:0%;transform-origin:bottom left}
  .grid-tile--topic-open[data-topic-mode~="top"] .tile-topic--top,
  .grid-tile--topic-open[data-topic-mode~="left"] .tile-topic--left,
  .grid-tile--topic-open[data-topic-mode~="right"] .tile-topic--right{
    opacity:1;transform:translate(var(--topic-offset-x),0) scale(1)
  }
  .grid-viewport.is-dragging:not(.has-center-topics) .tile-topic{opacity:0}
  .grid-viewport.is-dragging:not(.has-center-topics) .grid-tile--topic-open .tile-mark{box-shadow:none}
  .tile-portal{width:100%;height:100%;aspect-ratio:1;max-height:none;flex:none;appearance:none;padding:0;cursor:inherit;pointer-events:none;border-radius:50%;border:6px solid #77716d;box-shadow:0 0 0 2px #2b2826,inset 0 0 0 3px #18191e,inset 0 0 24px #08070d;background:radial-gradient(circle at 43% 38%,color-mix(in srgb,var(--portal-color) 75%,white),var(--portal-color) 23%,#121323 70%,#05060c 100%)}
  /* The square source is centered behind a round aperture; the rim sits above it. */
  .tile-portal--artwork{overflow:hidden;isolation:isolate}
  .tile-portal-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;border-radius:inherit;pointer-events:none;z-index:0}
  .tile-portal--artwork::after{content:'';position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 0 3px #18191e,inset 0 0 12px rgba(8,7,13,.6);pointer-events:none;z-index:1}
  .tile-name{position:absolute;left:50%;bottom:5%;transform:translateX(-50%);width:89%;font-size:clamp(12px,calc(var(--tile-size,240px) * .068),17px);max-width:89%;text-align:center;letter-spacing:.08em;color:#d8cab7;text-shadow:0 1px 1px #000;white-space:normal;overflow-wrap:break-word;text-wrap:balance;line-height:1.18}
  .grid-tile--long-title .tile-name{width:95%;font-size:clamp(9px,calc(var(--tile-size,240px) * .052),14px);letter-spacing:.025em;line-height:1.12;max-width:95%}
  .grid-tile--origin .tile-face{border-color:#ac9a86}
  :root{--header-height:52px}
  .site-header{position:fixed;z-index:20;inset:0 0 auto;height:var(--header-height);display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(18px,5vw,72px);background:rgba(14,15,18,.94);border-bottom:1px solid #5b554e;pointer-events:auto}
  .brand{display:flex;align-items:center;gap:9px;font-size:17px;font-weight:bold;letter-spacing:.19em;white-space:nowrap;color:#e8ddc9}
  .brand img{width:32px;height:32px;object-fit:contain;flex:none}
  .site-nav{display:flex;align-items:center;gap:16px;margin-left:auto;font:14px system-ui,sans-serif}
  .site-nav button{font:inherit;color:#e9dfd2;background:transparent;border:1px solid #81715a;padding:7px 12px;cursor:pointer}
  .site-nav button:hover,.site-nav button:focus-visible{background:#49404a;outline:2px solid #ae9875}
  #projects-menu{position:fixed;top:calc(var(--header-height) + 8px);right:clamp(12px,5vw,72px);width:min(360px,calc(100vw - 24px));padding:16px;background:#202027;border:1px solid #ae9875;box-shadow:0 12px 36px #0008;color:#e9dfd2}
  #projects-menu[hidden]{display:none}
  #project-search{display:block;width:100%;margin-top:8px;padding:10px;font:inherit;background:#15151b;color:inherit;border:1px solid #81715a}
  #project-result-count{font-size:12px;color:#c8c2cb;margin:10px 0}
  #project-results{display:flex;flex-direction:column;gap:4px;max-height:min(50dvh,420px);overflow:auto;overscroll-behavior:contain;touch-action:pan-y}
  .project-menu-group{display:grid;gap:.35rem;}
  .project-menu-group h3{margin:.65rem 0 .15rem;color:#d5c19b;font-size:.85rem;}
  #project-results button{text-align:left;min-height:42px}
  .header-note{position:absolute;left:50%;transform:translateX(-50%);max-width:calc(100% - 620px);text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;pointer-events:none;color:#a49b92;font-family:system-ui,sans-serif;font-size:11px;letter-spacing:.05em}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  @media(max-width:760px){.site-header{gap:8px;padding:0 12px}.brand{font-size:14px;letter-spacing:.12em}.site-nav{gap:8px;font-size:13px}.site-nav button{padding:7px 9px}.header-note{display:block;left:12px;right:12px;top:48px;max-width:none;transform:none;font-size:10px}.site-header{align-items:flex-start;padding-top:8px}:root{--header-height:76px}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
  .bloom-preview-content{min-height:0;overflow:auto;display:flex;flex-direction:column;gap:8px;flex:1;scrollbar-width:none}
  .bloom-close{flex-shrink:0}
  .bloom-read-more{margin-top:auto;align-self:flex-end;flex-shrink:0}
  .grid-bloom-module:has(.bloom-read-more){cursor:pointer}
  .video-item{margin:0;min-width:0;flex-shrink:0}
  .video-item figcaption,.video-count{font:12px/1.4 system-ui,sans-serif;color:#c8c2cb}
  .video-item .bloom-media{max-height:none;min-height:0}
  .is-big-bloom-waiting .grid-tile--selected .tile-select::after{content:'';position:absolute;inset:4px;border:3px solid #ffe0a3;box-shadow:inset 0 0 24px #ffd2827a,0 0 24px #ffd282b3;pointer-events:none;animation:selection-wait 1400ms ease-in-out infinite}
  .grid-viewport.is-big-bloom{overflow:clip}
  .is-bloom-opening .grid-tile--depth-transition{transition:transform 520ms cubic-bezier(.22,.75,.25,1)}
  .grid-tile--big-anchor{z-index:4}
  .big-bloom-card{padding:clamp(12px,calc(var(--tile-size) * .085),24px);gap:12px;overflow:hidden;transform-origin:top left}
  .big-bloom-card .bloom-title{font-size:clamp(18px,calc(var(--tile-size) * .09),24px)}
  .big-bloom-card .bloom-summary{font:400 clamp(12px,calc(var(--tile-size) * .067),16px)/1.55 system-ui,sans-serif;white-space:normal;max-height:none;overflow:visible}
  .big-bloom-card .bloom-media{max-height:calc(var(--tile-size) * .85)}
  .big-bloom-card--selected{border-color:#e3c99b;box-shadow:inset 0 0 0 5px #49404a,0 0 24px #d8bd9133}
  .big-bloom-card--selected .bloom-preview-content{flex:0 1 auto;max-height:calc(var(--tile-size) - 32px)}
  .bloom-preview-credit,.bloom-collection-list{font:12px/1.5 system-ui,sans-serif;color:#b8afbc;margin:6px 0}
  .bloom-collection-list{padding-left:20px}
  .site-help{position:relative}
  .site-nav #help-toggle{width:32px;height:32px;padding:0;border-radius:50%;cursor:help}
  #site-help-content{display:none;position:fixed;right:12px;top:calc(var(--header-height) + 8px);width:min(320px,calc(100vw - 24px));padding:16px;font:13px/1.5 system-ui,sans-serif;background:#242329;border:1px solid #a7977e;box-shadow:0 12px 36px #0008;color:#e9dfd2}
  .site-help.is-open #site-help-content{display:block}
  @media(hover:hover){.site-help:hover #site-help-content{display:block}}
  .site-help:has(:focus-visible) #site-help-content{display:block}
  .module-detail::backdrop{background:#11121855;animation:detail-backdrop-in 420ms ease-out both}
  .module-detail{position:fixed;inset:0;width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:0;border:0;background:transparent;overflow:hidden;pointer-events:auto}
  .module-detail>.site-header{pointer-events:auto}
  .module-detail-panel{pointer-events:auto;box-sizing:border-box;position:fixed;inset:var(--header-height) 0 0;margin:auto;width:min(980px,calc(100vw - 32px),calc(100dvh - 88px));height:min(980px,calc(100vw - 32px),calc(100dvh - 88px));max-width:none;max-height:none;padding:0;border:2px solid #ae9875;background:#202027;color:#e9dfd2;box-shadow:inset 0 0 0 5px #49404a,0 12px 64px #0008;overflow:hidden;user-select:text}
  @media(max-width:599px){
    .module-detail-panel{inset:var(--header-height) 0 auto;width:100%;height:calc(100dvh - var(--header-height) - max(64px,env(safe-area-inset-bottom)));margin:0;border:0;box-shadow:none;padding:0}
  }
  .reader-scroll-content{height:100%;box-sizing:border-box;padding:clamp(16px,3vw,40px);overflow:auto;overscroll-behavior:contain;touch-action:pan-y}
  .reader-scroll-thumb{position:absolute;right:3px;width:24px;touch-action:none;cursor:grab;user-select:none;z-index:1;border:0;background:transparent}
  .reader-scroll-thumb[hidden]{display:none}
  .reader-scroll-thumb::after{content:"";display:block;position:absolute;inset:0 9px;border-radius:8px;background:#bba079cc;transition:background 160ms,box-shadow 160ms}
  .reader-scroll-thumb:hover::after,.reader-scroll-thumb:focus-visible::after,.reader-scroll-thumb.is-dragging::after{background:#f2d29d;box-shadow:0 0 7px #d6ae6b88}
  .reader-scroll-thumb:focus-visible{outline:1px solid #e8d3b0;outline-offset:-4px;border-radius:12px}
  .reader-scroll-thumb.is-dragging{cursor:grabbing}
  @media(max-width:599px){.reader-scroll-content{padding:20px 28px 20px 16px}.reader-scroll-thumb{right:0}}
  .module-detail[open] .module-detail-panel{animation:detail-panel-in 420ms cubic-bezier(.2,.7,.2,1) both}
  @keyframes detail-panel-in{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}
  @keyframes detail-backdrop-in{from{background:#11121800}to{background:#11121855}}
  .module-detail h1,.module-detail-content{max-width:900px;margin-left:auto;margin-right:auto}
  .bloom-summary.module-document>:first-child{margin-top:0}
  .bloom-summary.module-document>:last-child{margin-bottom:0}
  .bloom-summary.module-document p{margin:.45em 0}
  .bloom-summary.module-document :is(h2,h3,h4,h5,h6){font-size:1.1em;line-height:1.3;margin:.7em 0 .35em}
  .bloom-summary.module-document :is(ul,ol){padding-left:1.4em;margin:.45em 0}
  .bloom-summary.module-document blockquote{margin:.5em 0;padding:0 .6em}
  .bloom-summary.module-document pre{padding:.6em}
  .module-document{overflow-wrap:anywhere}
  .module-document:not(.bloom-summary){font:17px/1.7 system-ui,sans-serif}
  .module-document pre{white-space:pre-wrap;padding:16px;background:#15151b;overflow:auto}
  .module-document h2,.module-document h3,.module-document h4{line-height:1.25;margin-top:1.8em}
  .module-document a,.module-detail-content>a{color:#e8d3b0}
  .module-document :not(pre)>code{font-size:.9em;padding:.12em .3em;background:#15151b;border-radius:3px}
  .module-document blockquote{margin:1.2em 0;padding:.1em 1em;border-left:3px solid #ae9875;color:#cfc6bb}
  .module-document li>p{margin:.35em 0}
  .module-document li ul,.module-document li ol{margin:.35em 0}
  .module-document .module-task-item{list-style:none}
  .module-task-item>input{margin:0 .6em 0 -1.3em;accent-color:#ae9875}
  .module-document-table{max-width:100%;overflow-x:auto;touch-action:pan-x pan-y;margin:1.2em 0}
  .module-document table{width:100%;border-collapse:collapse;font-size:.9em}
  .module-document th,.module-document td{padding:.55em .7em;border:1px solid #62594f;text-align:left;vertical-align:top}
  .module-document th{background:#302d30}
