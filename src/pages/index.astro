---
const title='babuni.dev — Living Grid Prototype';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#141518" />
  <meta name="description" content="An interactive portfolio toy-box prototype: explore a freely draggable wall of creative project tiles." />
  <title>{title}</title>
</head>
<body>
  <main class="experience" aria-label="Living grid prototype">
    <div id="grid-viewport" class="grid-viewport" tabindex="0" aria-label="Endless project grid. Drag with a mouse or finger to move. Focus and use arrow keys, or press Home to recenter.">
      <div id="grid-world" class="grid-world"></div>
    </div>
    <header class="site-header">
      <div class="brand">BABUNI.DEV</div>
      <span class="header-note">Living grid prototype</span>
    </header>
    <div class="help-panel">
      <span class="instruction">Drag or swipe to explore · Arrow keys also work</span>
      <button id="reset-view" type="button">Return to center</button>
    </div>
    <div id="grid-status" class="sr-only" role="status" aria-live="polite"></div>
  </main>
  <script>
    import '../scripts/grid';
  </script>
</body>
</html>
<style is:global>
  :root {font-family:Georgia,'Times New Roman',serif;color-scheme:dark;font-synthesis:none}
  *{box-sizing:border-box}
  html,body{width:100%;height:100%;margin:0;background:#17181a;overflow:hidden}
  button{font:inherit}
  .experience,.grid-viewport{position:fixed;inset:0;width:100%;height:100%}
  .grid-viewport{overflow:hidden;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;outline-offset:-4px}
  .grid-viewport.is-dragging{cursor:grabbing}
  .grid-viewport:focus-visible{outline:3px solid #beabd8}
  .grid-world{position:absolute;top:0;left:0;will-change:transform;pointer-events:none}
  .grid-tile{position:absolute;width:var(--tile-size,240px);height:var(--tile-size,240px);padding:2px;background:#111215}
  .tile-face{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7%;position:relative;border:1px solid #686461;background:radial-gradient(ellipse at 42% 40%,#55514e 0%,#423f3e 50%,#292929 100%);box-shadow:inset 0 0 0 4px #393837,inset 0 0 0 5px #6a6258}
  /* The child face grows into place; the parent remains free for line movement. */
  .grid-tile--spawning .tile-face{animation:tile-spawn 373ms cubic-bezier(.18,.78,.22,1) var(--tile-spawn-delay,0ms) both;transform-origin:center}
  @keyframes tile-spawn{
    0%{opacity:0;transform:scale(.28)}
    73%{opacity:1;transform:scale(1.065)}
    100%{opacity:1;transform:scale(1)}
  }
  .tile-face::before{content:'';position:absolute;inset:9px;border:1px solid #777068;opacity:.43;pointer-events:none}
  .tile-mark{width:7px;height:7px;flex:none;z-index:2;border:1px solid #b6a487;transform:rotate(45deg);transition:background-color 180ms,box-shadow 180ms,border-color 180ms}
  .grid-tile--topic-open .tile-mark{border-color:#f5ecda;background:var(--portal-color);box-shadow:0 0 0 2px #1b1b21,0 0 9px 3px var(--portal-color),0 0 17px var(--portal-color)}
  .tile-topic{position:absolute;top:6px;left:calc(50% + 13px);right:6px;z-index:3;pointer-events:none;padding:5px 7px;border-radius:3px;border:1px solid #837c91;background:rgba(19,20,28,.96);box-shadow:0 4px 16px rgba(0,0,0,.44);font:500 clamp(9px,calc(var(--tile-size,240px) * .047),12px)/1.18 system-ui,sans-serif;letter-spacing:.015em;color:#f0e8d9;overflow-wrap:anywhere;opacity:0;transform:translateY(5px) scale(.95);transition:opacity 150ms ease,transform 180ms ease}
  .grid-tile--topic-open .tile-topic{opacity:1;transform:translateY(0) scale(1)}
  .grid-viewport.is-dragging .tile-topic{opacity:0}
  .grid-viewport.is-dragging .grid-tile--topic-open .tile-mark{box-shadow:none}
  .tile-portal{width:59%;aspect-ratio:1;max-height:59%;flex:none;appearance:none;padding:0;cursor:help;pointer-events:auto;border-radius:50%;border:6px solid #77716d;box-shadow:0 0 0 2px #2b2826,inset 0 0 0 3px #18191e,inset 0 0 24px #08070d;background:radial-gradient(circle at 43% 38%,color-mix(in srgb,var(--portal-color) 75%,white),var(--portal-color) 23%,#121323 70%,#05060c 100%)}
  .tile-portal:focus-visible{outline:3px solid #e8d7b5;outline-offset:4px}
  .tile-name{font-size:clamp(12px,calc(var(--tile-size,240px) * .068),17px);max-width:89%;text-align:center;letter-spacing:.08em;color:#d8cab7;text-shadow:0 1px 1px #000;white-space:normal;overflow-wrap:break-word;text-wrap:balance;line-height:1.18}
  .grid-tile--long-title .tile-name{font-size:clamp(10px,calc(var(--tile-size,240px) * .052),14px);letter-spacing:.025em;line-height:1.12;max-width:95%}
  .grid-tile--long-title .tile-portal{width:53%;max-height:53%}
  .grid-tile--origin .tile-face{border-color:#ac9a86}
  .site-header{position:absolute;z-index:2;inset:0 0 auto;height:52px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(18px,5vw,72px);background:rgba(14,15,18,.94);border-bottom:1px solid #5b554e;pointer-events:none}
  .brand{font-size:17px;font-weight:bold;letter-spacing:.19em;white-space:nowrap;color:#e8ddc9}
  .header-note{color:#a49b92;font-family:system-ui,sans-serif;font-size:11px;letter-spacing:.05em}
  .help-panel{position:absolute;z-index:2;right:18px;bottom:18px;left:18px;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:12px;pointer-events:none;font-family:system-ui,sans-serif;font-size:12px;color:#d6d3d0}
  .instruction{padding:8px 13px;border-radius:30px;background:rgba(10,10,12,.82)}
  .help-panel button{pointer-events:auto;cursor:pointer;padding:8px 13px;border:1px solid #90816c;border-radius:24px;color:#eee4d3;background:rgba(21,19,20,.93)}
  .help-panel button:hover{background:#453c36}
  .help-panel button:focus-visible{outline:2px solid #d0b594;outline-offset:3px}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  @media(max-width:520px){.header-note{display:none}.help-panel{bottom:12px}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
