---
import SeoHead from '../components/SeoHead.astro';
const {title,description,image,structured}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead title={title} description={description} image={image} /><link rel="icon" type="image/webp" href="/favicon.webp" />{structured&&<script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')} />}</head>
<body><header><a class="brand" href="/">BABUNI.DEV</a><nav aria-label="Site navigation"><a href="/">Living grid</a><a href="/projects/">All projects</a></nav></header><main><slot /></main><footer>Projects and creative direction by Babuni.dev.</footer></body></html>
<style is:global>
:root{color-scheme:dark}*{box-sizing:border-box;scrollbar-width:none}*::-webkit-scrollbar{display:none}body{margin:0;background:#1d1b18;color:#ead8bd;font:18px/1.7 system-ui,sans-serif}header{display:flex;justify-content:space-between;gap:20px;padding:16px clamp(18px,5vw,70px);background:#101112;border-bottom:1px solid #9b876e}nav{display:flex;gap:20px}.brand{font-family:Georgia,serif;letter-spacing:.16em}a{color:#e8d3b0}a:focus-visible{outline:2px solid #f2ddb8;outline-offset:4px}main{max-width:1100px;margin:30px auto;padding:0 24px 48px}h1,h2,h3,h4{font-family:Georgia,serif;color:#f2ddb8;line-height:1.25}h1{font-size:clamp(28px,5vw,44px)}article{overflow-wrap:anywhere}pre{background:#121210;padding:20px;overflow:auto}code{font-size:.9em}blockquote{border-left:3px solid #ae9875;margin-left:0;padding-left:20px}table{border-collapse:collapse;display:block;overflow:auto}th,td{padding:8px 12px;border:1px solid #726858}img{max-width:100%;height:auto}.project-art{width:112px;height:112px;object-fit:cover;border-radius:50%;float:right;margin:0 0 20px 20px}.module-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;list-style:none;padding:0}.module-list li{border:2px solid #9b876e;padding:18px;background:#29261f}.module-list h2{margin-top:0;font-size:24px}.media-frame{border:2px solid #9b876e;padding:5px;background:#37333a;margin:22px 0}.media-frame :is(iframe,video){display:block;width:100%;aspect-ratio:16/9;border:0}figure{margin:24px 0}figcaption,.credit{font-size:15px;color:#d6c3a8}footer{border-top:1px solid #5b554e;padding:18px 24px;font-size:14px}summary{cursor:pointer}@media(max-width:600px){header{flex-wrap:wrap}main{padding:0 16px}body{font-size:17px}}
</style>
