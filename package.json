{
  "name": "babuni-dev",
  "author": "Babuni.dev",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test:grid": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "content:check": "node scripts/check-webp.mjs && node --experimental-strip-types scripts/content-tools.mjs",
    "content:template": "node --experimental-strip-types scripts/content-tools.mjs template",
    "prebuild": "npm run content:check && npm run content:prepare",
    "content:sync": "node --experimental-strip-types scripts/sync-repositories.mjs",
    "content:report": "node --experimental-strip-types scripts/repository-report.mjs",
    "content:prepare": "node --experimental-strip-types scripts/build-document-assets.mjs",
    "predev": "npm run content:prepare",
    "pretest:grid": "npm run content:prepare",
    "bundle:report": "node scripts/report-bundle-size.mjs",
    "artwork:import": "node --experimental-strip-types scripts/import-portal-artwork.mjs"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "marked": "^18.1.2"
  }
}
